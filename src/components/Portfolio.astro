---
import { Image } from 'astro:assets';
import kivaImage from '../assets/projects/kiva.webp';
import skeiloPosImage from '../assets/projects/skeilo-pos.webp';

const cases = [
	{
		sector: 'Retail e-commerce',
		name: 'Experiencia de compra premium',
		desc: 'Ecosistema de ventas digital con diseño centrado en el usuario para potenciar la comercialización de prendas oversize de alta calidad.',
		metric: '100% autogestionable',
		image: kivaImage,
		alt: 'Captura de la interfaz de KIVA, tienda online de ropa oversize',
	},
	{
		sector: 'SaaS B2B',
		name: 'Ecosistema de gestión integral',
		desc: 'Centralización de inventario, catálogo, terminal de mesas y validación automatizada de pagos para optimizar la operación comercial.',
		metric: 'Operación centralizada en un solo panel',
		image: skeiloPosImage,
		alt: 'Captura de la interfaz de skeiloPos, plataforma de gestión comercial',
	},
];
---

<section id="portafolio" class="portfolio">
	<div class="section-inner">
		<div data-reveal class="section-head">
			<div class="section-head-copy">
				<span class="eyebrow">06 — Casos de éxito</span>
				<h2>Proyectos reales, resultados medibles.</h2>
				<p>
					Estos son algunos de los productos que hemos construido: el sector, el reto y el
					resultado medible de cada uno.
				</p>
			</div>
		</div>

		<div class="cases-grid">
			{
				cases.map((item) => (
					<div data-reveal class="case-card">
						<div class="case-image">
							<Image
								src={item.image}
								alt={item.alt}
								width={640}
								height={323}
								densities={[1, 2]}
								format="webp"
								loading="lazy"
							/>
						</div>
						<div class="case-body">
							<span class="case-sector">{item.sector}</span>
							<h3>{item.name}</h3>
							<p>{item.desc}</p>
							<div class="case-metric">{item.metric}</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.portfolio {
		padding: 96px 24px;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
	}

	.section-inner {
		max-width: 1280px;
		margin: 0 auto;
	}

	.eyebrow {
		font: 500 12px var(--font-mono);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-mint);
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
	}

	.section-head-copy {
		max-width: 640px;
	}

	.section-head-copy h2 {
		font: 600 clamp(30px, 4.5vw, 50px) / 1.04 var(--font-display);
		letter-spacing: -0.025em;
		margin: 16px 0 0;
	}

	.section-head-copy p {
		font: 400 17px / 1.6 var(--font-sans);
		color: var(--color-ink-muted);
		margin: 16px 0 0;
	}

	.cases-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin: 44px 0 0;
	}

	.cases-grid > :nth-child(2) {
		transition-delay: 0.06s;
	}

	.case-card {
		background: rgba(255, 255, 255, 0.025);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		overflow: hidden;
		transition: border-color 0.2s;
	}

	.case-card:hover {
		border-color: rgba(0, 224, 184, 0.35);
	}

	.case-image {
		height: 180px;
		background-color: var(--color-navy);
		position: relative;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.case-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.case-body {
		padding: 24px;
	}

	.case-sector {
		font: 400 11px var(--font-mono);
		letter-spacing: 0.1em;
		color: var(--color-mint);
		text-transform: uppercase;
	}

	.case-body h3 {
		font: 600 20px var(--font-display);
		letter-spacing: -0.01em;
		margin: 10px 0 0;
	}

	.case-body p {
		font: 400 14.5px / 1.55 var(--font-sans);
		color: var(--color-ink-muted);
		margin: 8px 0 16px;
	}

	.case-metric {
		font: 700 22px var(--font-display);
		color: var(--color-mint);
	}

	@media (max-width: 980px) {
		.portfolio {
			padding-top: 64px;
			padding-bottom: 64px;
		}
	}

	@media (max-width: 620px) {
		.portfolio {
			padding: 48px 18px;
		}

		.cases-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
